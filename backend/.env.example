# Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual values.

# The allowed origin for CORS requests
CORS_ORIGIN=http://localhost:3000

# Google AI Gemini API Key (obtained from Google AI Studio)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Google OAuth Credentials (for sign-in)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JSON Web Token secret for authentication
JWT_SECRET=your_jwt_secret_here

# MongoDB Connection URI (e.g. mongodb://localhost:27017/ai_interviewer or MongoDB Atlas cluster connection string)
MONGODB_URI=your_mongodb_connection_uri_here

# Port to run the Express backend server on
PORT=3001

# Enable/Disable developer backdoor login (true/false)
# WARNING: NEVER enable this in production environments!
ENABLE_DEV_LOGIN=true

# Google Gemini AI Model name
GOOGLE_AI_MODEL=gemini-2.5-flash
